--- a/kernel-open/nvidia/nv-pci.c
+++ b/kernel-open/nvidia/nv-pci.c
@@ -3280,3 +3280,20 @@
     }

+#if NV_PCI_ASYNC_PROBE_SUPPORTED
+    /* Keep NVIDIA's ordinary probe policy on hosts without CMP170.
+     * A CMP still requires the validated serial RM initialization order. */
+    {
+        struct pci_dev *cmp;
+        nv_pci_driver.driver.probe_type = PROBE_PREFER_ASYNCHRONOUS;
+        cmp = pci_get_device(PCI_VENDOR_ID_NVIDIA, 0x20C2, NULL);
+        if (cmp == NULL)
+            cmp = pci_get_device(PCI_VENDOR_ID_NVIDIA, 0x2082, NULL);
+        if (cmp != NULL)
+        {
+            nv_pci_driver.driver.probe_type = PROBE_FORCE_SYNCHRONOUS;
+            pci_dev_put(cmp);
+        }
+    }
+#endif
+
     smp_store_release(&nv_pci_driver_registration_in_progress, NV_TRUE);
